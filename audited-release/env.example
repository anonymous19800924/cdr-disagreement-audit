OPENROUTER_API_KEY=your_openrouter_key

# Dataset folder under data/: GPQA, SuperGPQA, or HLE
DATASET=GPQA

# OpenRouter model identifiers and matching trace files under data/${DATASET}/
CONSULTANT_1=openai/gpt-4o
CONSULTANT_1_FILENAME=gpt_4o.json
CONSULTANT_2=anthropic/claude-sonnet-4
CONSULTANT_2_FILENAME=claude.json
JUDGE=openai/gpt-4o-mini

# Prompt directory and output root, relative to the repository root
PROMPTS_SET=prompts
RESULTS_DIR=logs

# Optional: override the default output filename
# OUTPUT_FILE=results.json
