  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "reliability-weighted-peer-review-reference-labels",
  "description": "Per-opinion adjudication records, reliability-weighted posteriors, arbitration votes, and human annotations for 10,762 disputed review opinions, with audit artifacts that regenerate the reported statistics.",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://anonymous.4open.science/r/cdr-disagreement-audit-C1E7",
  "version": "1.1.0",
  "citeAs": "Reliability-Weighted Reference Labels for AI-Reviewer Benchmarks: 10,762 Contested Opinions and an Identifiability Result (2026).",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "surface-items",
      "name": "surface_items.csv",
      "contentUrl": "data/surface_items.csv",
      "encodingFormat": "text/csv"
    },
    {
      "@type": "cr:FileObject",
      "@id": "anchor-votes",
      "name": "anchor_votes.jsonl",
      "contentUrl": "data/anchor_votes.jsonl",
      "encodingFormat": "application/jsonl"
    },
    {
      "@type": "cr:FileObject",
      "@id": "anchor-consensus",
      "name": "anchor_consensus.jsonl",
      "contentUrl": "data/anchor_consensus.jsonl",
      "encodingFormat": "application/jsonl"
    },
    {
      "@type": "cr:FileObject",
      "@id": "heldout-items",
      "name": "heldout_items.csv",
      "contentUrl": "data/heldout_items.csv",
      "encodingFormat": "text/csv"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "surface-opinions",
      "name": "surface_opinions",
      "description": "One row per disputed opinion.",
      "field": [
        {"@type": "cr:Field", "name": "key", "dataType": "sc:Text",
         "source": {"fileObject": {"@id": "surface-items"}, "extract": {"column": "key"}}},
        {"@type": "cr:Field", "name": "paper_id", "dataType": "sc:Text",
         "source": {"fileObject": {"@id": "surface-items"}, "extract": {"column": "paper_id"}}},
        {"@type": "cr:Field", "name": "verdict_conflict", "dataType": "sc:Text",
         "source": {"fileObject": {"@id": "surface-items"}, "extract": {"column": "verdict_conflict"}}},
        {"@type": "cr:Field", "name": "verdict_rebuttal", "dataType": "sc:Text",
         "source": {"fileObject": {"@id": "surface-items"}, "extract": {"column": "verdict_rebuttal"}}},
        {"@type": "cr:Field", "name": "posterior_incorrect", "dataType": "sc:Float",
         "source": {"fileObject": {"@id": "surface-items"}, "extract": {"column": "posterior_incorrect"}}},
        {"@type": "cr:Field", "name": "calibrated_label", "dataType": "sc:Integer",
         "source": {"fileObject": {"@id": "surface-items"}, "extract": {"column": "calibrated_label"}}}
      ]
    }
  ]
}
